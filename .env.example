# ─────────────────────────────────────────────────────────────
# .env  —  Parrocchia di Sant'Eligio
# Copia questo file in .env e compila i valori reali.
# NON committare mai .env su git!
# ─────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────
APP_NAME=Parrocchia di Sant'Eligio
APP_URL=https://santeligio.it
NODE_ENV=production

# ── Backend ───────────────────────────────────────────────────
PORT=3000
JWT_SECRET=cambia_questo_con_una_stringa_random_di_almeno_64_caratteri
JWT_EXPIRES_IN=7d

# Credenziali primo utente admin — usate da `npm run seed`
ADMIN_EMAIL=admin@santeligio.it
ADMIN_PASSWORD=cambia_questa_password_admin

# ── MongoDB ───────────────────────────────────────────────────
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=cambia_questa_password_sicura
MONGO_DB_NAME=santeligio
MONGO_APP_PASSWORD=cambia_questa_password_app
# MONGO_URI è generata automaticamente in docker-compose usando santeligio_app + MONGO_APP_PASSWORD

# ── Uploads ───────────────────────────────────────────────────
UPLOAD_MAX_SIZE_MB=150
UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,image/webp,application/pdf,video/mp4,video/webm,video/ogg,video/quicktime

# ── Email (per modulo contatti) ───────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=parrocchia@santeligio.it
SMTP_PASS=app_password_qui
MAIL_FROM="Parrocchia Sant'Eligio <parrocchia@santeligio.it>"

# ── Mongo Express (solo dev) ──────────────────────────────────
MONGOEXPRESS_USER=admin
MONGOEXPRESS_PASSWORD=admin_secret

# ── Grest (portale iscrizioni famiglie, modulo backend/src/grest) ──
GREST_ANNO=2026                     # edizione: sceglie i template assets/grest/<modulo>_<anno>.odt
GREST_ISCRIZIONI_APERTE=true        # false = nuove registrazioni chiuse
GREST_MAX_ISCRITTI=196              # limite posti (conta tutti gli iscritti in archivio)
GREST_PUBLIC_URL=https://parrocchiasanteligio.it   # base dei link nelle email
# GREST_JWT_SECRET=                 # opzionale: altrimenti derivato da JWT_SECRET (mai uguale)
# GREST_JWT_EXPIRES_IN=7d
# SMTP per le email di attivazione / reimpostazione password (vuoto = email disattivate)
GREST_SMTP_HOST=smtp-relay.brevo.com
GREST_SMTP_PORT=587
GREST_SMTP_USER=
GREST_SMTP_PASS=
GREST_MAIL_FROM="Parrocchia Sant'Eligio <noreply@parrocchiasanteligio.it>"
# GOTENBERG_URL=http://gotenberg:3000   # conversione ODT → PDF
